{
  "name": "cider",
  "applicationId": "Cider",
  "productName": "Cider",
  "version": "1.6.3",
  "description": "A new cross-platform Apple Music experience based on Electron and Vue.js written from scratch with performance in mind.",
  "license": "AGPL-3.0",
  "main": "./build/index.js",
  "author": "Cider Collective <cryptofyre@cider.sh> (https://cider.sh)",
  "repository": "github:ciderapp/Cider",
  "bugs": {
    "url": "https://github.com/ciderapp/Cider/issues?q=is%3Aopen+is%3Aissue+label%3Abug"
  },
  "homepage": "https://cider.sh/",
  "packageManager": "pnpm@10.34.4",
  "buildResources": "resources",
  "scripts": {
    "build": "tsc && lessc ./src/renderer/style.less ./src/renderer/style.css",
    "start": "pnpm run build && electron ./build/index.js",
    "dist": "pnpm run build && electron-builder --publish=never",
    "dist:win": "pnpm run build && electron-builder --win --publish=never",
    "dist:linux": "pnpm run build && electron-builder --linux --publish=never",
    "dist:universalNotWorking": "pnpm run build && electron-builder --mac --universal --publish:never",
    "winget": "pnpm run build && electron-builder --win -c winget.json",
    "msft": "pnpm run build && electron-builder -c msft-package.json",
    "mstest": "pnpm run build && electron-builder -c msft-test.json",
    "steamdeck": "pnpm run build && electron-builder --linux -c steam-deck.json",
    "format:check": "npx prettier --check \"src/**/*.{js,json,ts,less}\"",
    "format:write": "npx prettier --write \"src/**/*.{js,json,ts,less}\"",
    "flatpak-install": "flatpak-builder --user --install --force-clean .flatpak flatpak/sh.cider.Cider.yml"
  },
  "dependencies": {
    "@electron/notarize": "^1.2.4",
    "adm-zip": "^0.6.0",
    "castv2-client": "^1.2.0",
    "chokidar": "^3.6.0",
    "discord-auto-rpc": "^1.0.17",
    "ejs": "^3.1.10",
    "electron-fetch": "^1.9.1",
    "electron-log": "^4.4.8",
    "electron-store": "^8.2.0",
    "electron-window-state": "^5.0.3",
    "express": "^4.22.2",
    "get-port": "5.1.1",
    "jimp": "^1.6.0",
    "lastfmapi": "^0.1.1",
    "mdns-js": "github:ciderapp/node-mdns-js",
    "mpris-service": "^2.1.2",
    "music-metadata": "11.15.0",
    "node-airtunes2": "^2.5.0",
    "node-ssdp": "^4.0.1",
    "qrcode": "^1.5.4",
    "source-map-support": "^0.5.21",
    "ts-md5": "1.3.1",
    "upnp-mediarenderer-client": "1.4.0",
    "wallpaper": "5.0.1",
    "ws": "^8.21.3",
    "xml2js": "^0.6.2",
    "youtube-search-without-api-key": "^1.1.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/discord-rpc": "4.0.4",
    "@types/express": "^4.17.25",
    "@types/musickit": "github:ciderapp/musickit-types",
    "@types/node": "^20.19.33",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "electron": "github:castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "26.2.0",
    "electron-builder-notarize-pkg": "^1.2.0",
    "less": "^4.5.1",
    "node-gyp": "^10.3.1",
    "prettier": "2.8.8",
    "typescript": "^5.9.3",
    "vue-devtools": "^5.1.4"
  },
  "fileAssociations": [
    {
      "name": "Cider",
      "mimeType": "x-scheme-handler/ame;x-scheme-handler/itms;x-scheme-handler/itmss;x-scheme-handler/musics;x-scheme-handler/music;",
      "schemes": [
        "ame",
        "cider",
        "itms",
        "itmss",
        "musics",
        "music"
      ],
      "protocols": [
        "ame",
        "cider",
        "itms",
        "itmss",
        "musics",
        "music"
      ]
    }
  ],
  "build": {
    "electronVersion": "44.1.0",
    "electronDownload": {
      "version": "44.1.0+wvcus",
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/v"
    },
    "appId": "sh.cider.Cider",
    "productName": "Cider",
    "afterPack": "./resources/afterPack.js",
    "afterSign": "./resources/notarize.js",
    "protocols": [
      {
        "name": "Cider",
        "schemes": [
          "ame",
          "cider",
          "itms",
          "itmss",
          "musics",
          "music"
        ]
      }
    ],
    "extends": null,
    "files": [
      "./build/**/*",
      "./src/**/*",
      "./resources/icons/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "synopsis": "A new look into listening and enjoying music in style and performance. ",
      "category": "AudioVideo",
      "icon": "sh.cider.Cider",
      "executableName": "sh.cider.Cider",
      "publish": null
    },
    "appx": {
      "applicationId": "Cider",
      "displayName": "Cider",
      "identityName": "Cider",
      "publisherDisplayName": "Cider Collective",
      "backgroundColor": "transparent",
      "setBuildNumber": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "deleteAppDataOnUninstall": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "pkg": {
      "installLocation": "/Applications",
      "background": {
        "file": "./resources/bg.png",
        "alignment": "bottomleft"
      },
      "allowAnywhere": true,
      "allowCurrentUserHome": true,
      "allowRootDirectory": true,
      "license": "./LICENSE",
      "isVersionChecked": false,
      "isRelocatable": false,
      "overwriteAction": "upgrade"
    },
    "snap": {
      "slots": [
        {
          "mpris": {
            "interface": "mpris"
          }
        }
      ]
    },
    "dmg": {
      "background": "./resources/bg.tiff",
      "icon": "resources/icons/icon.ico"
    },
    "mas": {
      "entitlements": "./resources/entitlements.mac.plist",
      "entitlementsInherit": "./resources/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icons/icon.ico"
    },
    "directories": {
      "buildResources": ".",
      "output": "dist"
    },
    "mac": {
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "icon": "./resources/icons/icon.icns",
      "category": "public.app-category.music",
      "entitlements": "./resources/entitlements.mac.plist",
      "entitlementsInherit": "./resources/entitlements.mac.plist",
      "darkModeSupport": true,
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert"
      }
    }
  },
  "engines": {
    "node": ">= 22.12.0"
  },
  "pnpm": {
    "overrides": {
      "lastfm": "0.9.4",
      "dbus-next>abstract-socket": "invalid",
      "node-abi": "4.35.0",
      "axlsign": "https://codeload.github.com/ciderapp/curve25519-js/tar.gz/cae68782564b83ffa1c7c757e40a3944cb140290",
      "chacha-js": "https://codeload.github.com/ciderapp/chacha20poly1305/tar.gz/f85941b8f5c62843a1459758cc3dbabad9f849cb",
      "dns-js": "https://codeload.github.com/ciderapp/node-dns-js/tar.gz/212b6c903db40bcd501af741e51cd20d676acbc9",
      "prebuild-install@github:ciderapp/prebuild-install": "https://codeload.github.com/ciderapp/prebuild-install/tar.gz/a305d02ccffa94de8863c0b3328b98dc6d3a4ef2",
      "bn.js@4.12.2": "4.12.3",
      "brace-expansion@2.0.2": "2.1.4",
      "brace-expansion@5.0.5": "5.0.9",
      "fast-uri@3.1.0": "3.1.6",
      "ip-address@10.1.0": "10.3.1",
      "lodash@4.17.23": "4.18.0",
      "minimatch@5.1.6": "5.1.8",
      "path-to-regexp@0.1.12": "0.1.13",
      "picomatch@2.3.1": "2.3.2",
      "picomatch@4.0.3": "4.0.4",
      "protobufjs@6.11.4": "7.6.5",
      "protobufjs@7.6.3": "7.6.5",
      "qs@6.14.2": "6.16.0",
      "qs@6.15.3": "6.16.0",
      "tar@7.5.9": "7.5.21",
      "underscore@1.13.7": "1.13.8",
      "ws@7.5.10": "7.5.11",
      "xml2js@0.4.23": "0.6.2"
    }
  }
}
